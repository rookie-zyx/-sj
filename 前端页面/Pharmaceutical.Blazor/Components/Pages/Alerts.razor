@page "/alerts"
@rendermode InteractiveServer
@inject DrugApiService DrugApi
@inject ExportApiService ExportApi
@inject IJSRuntime JS

<PageTitle>库存预警 - 药品管理综合系统</PageTitle>

<div class="page-header">
    <h1>智能库存预警看板</h1>
    <p class="page-subtitle">监控库存低于安全线（@_threshold）的紧缺药品</p>
</div>

@if (_loadError != null)
{
    <div class="alert alert-error">@_loadError</div>
}
else if (_loading)
{
    <LoadingSpinner IsLoading="true" Text="正在加载预警数据..." />
}
else
{
    <div class="alert-stat-card">
        <div class="stat-number">@_lowStockDrugs.Count</div>
        <div class="stat-info">
            <h2>低库存药品种类</h2>
            <p>库存低于 @_threshold 的药品需及时补货，请通知采购人员处理。</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header toolbar">
            <h2>预警明细</h2>
            <div class="toolbar-actions">
                <a href="/purchase-orders" class="btn btn-primary btn-sm">去创建采购单</a>
                <button class="btn btn-secondary btn-sm" @onclick="ExportLowStock" disabled="@_exporting">导出 CSV</button>
                <button class="btn btn-secondary btn-sm" @onclick="LoadAlerts">刷新</button>
            </div>
        </div>
        <div class="card-body table-wrapper">
            @if (!_lowStockDrugs.Any())
            {
                <div class="empty-state success-state">
                    <span class="empty-icon">✓</span>
                    当前无低库存药品，库存状况良好
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>药品名称</th>
                            <th>规格</th>
                            <th>当前库存</th>
                            <th>供应商</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var drug in _lowStockDrugs)
                        {
                            <tr class="row-low-stock">
                                <td>@drug.DrugName</td>
                                <td>@drug.Specification</td>
                                <td class="text-danger fw-bold">@drug.StockQuantity</td>
                                <td>@drug.SupplierName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private List<DrugDto> _lowStockDrugs = new();
    private bool _loading = true;
    private string? _loadError;
    private int _threshold = 200;
    private bool _exporting;

    protected override async Task OnInitializedAsync() => await LoadAlerts();

    private async Task LoadAlerts()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            var settings = await DrugApi.GetAlertSettingsAsync();
            if (settings != null) _threshold = settings.LowStockThreshold;
            _lowStockDrugs = await DrugApi.GetLowStockDrugsAsync(_threshold);
        }
        catch (Exception ex)
        {
            _loadError = $"无法加载预警数据：{ex.Message}";
            _lowStockDrugs = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportLowStock()
    {
        _exporting = true;
        var bytes = await ExportApi.DownloadLowStockAsync();
        if (bytes != null)
            await JS.InvokeVoidAsync("downloadFileFromBytes", "low-stock.csv", Convert.ToBase64String(bytes));
        _exporting = false;
    }
}
