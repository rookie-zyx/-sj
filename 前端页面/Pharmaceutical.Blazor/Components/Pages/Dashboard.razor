@page "/dashboard"
@rendermode InteractiveServer
@inject DashboardApiService DashboardApi
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>运营仪表盘</PageTitle>

<div class="page-header">
    <h1>运营仪表盘</h1>
    <p class="page-subtitle">库存估值、动销分析与智能补货建议</p>
</div>

@if (_error != null)
{
    <div class="alert alert-error">@_error</div>
}

@if (_loading) { <LoadingSpinner IsLoading="true" Text="正在加载仪表盘..." /> }
else if (_data != null)
{
    <div class="home-cards">
        <div class="home-card"><h3>库存总值</h3><p class="stat-number stat-primary">¥ @_data.TotalInventoryValue.ToString("N2")</p></div>
        <div class="home-card alert-card"><h3>低库存品种</h3><p class="stat-number">@_data.LowStockCount</p></div>
        <div class="home-card"><h3>临期批次</h3><p class="stat-number">@_data.ExpiryAlertCount</p></div>
        <div class="home-card"><h3>在售药品</h3><p class="stat-number stat-primary">@_data.ActiveDrugCount</p></div>
        <div class="home-card"><h3>待审采购单</h3><p class="stat-number">@_data.PendingPurchaseOrders</p></div>
    </div>

    <div class="quick-links">
        <a href="/alerts" class="btn btn-secondary btn-sm">低库存预警</a>
        <a href="/expiry-alerts" class="btn btn-secondary btn-sm">效期预警</a>
        <a href="/purchase-orders" class="btn btn-secondary btn-sm">采购单</a>
        <button class="btn btn-secondary btn-sm" @onclick="Load">刷新</button>
    </div>

    <div class="chart-row">
        <div class="card chart-card">
            <div class="card-header"><h2>运营概览</h2></div>
            <div class="card-body chart-container">
                <canvas id="kpiChart"></canvas>
            </div>
        </div>
        <div class="card chart-card">
            <div class="card-header"><h2>Top10 动销（30天）</h2></div>
            <div class="card-body chart-container">
                <canvas id="topMovingChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card" style="margin-top:1rem">
        <div class="card-header"><h2>智能补货建议</h2></div>
        <div class="card-body table-wrapper">
            @if (!_data.ReorderSuggestions.Any())
            {
                <div class="empty-state success-state">当前无需补货</div>
            }
            else
            {
                <table class="data-table">
                    <thead><tr><th>药品</th><th>当前库存</th><th>日均出库</th><th>预计断货(天)</th><th>建议订货量</th></tr></thead>
                    <tbody>
                        @foreach (var s in _data.ReorderSuggestions)
                        {
                            <tr class="@(s.DaysUntilStockout <= 7 ? "row-low-stock" : "")">
                                <td>@s.DrugName</td>
                                <td>@s.CurrentStock</td>
                                <td>@s.DailyAverageOut</td>
                                <td>@s.DaysUntilStockout</td>
                                <td class="fw-bold">@s.SuggestedReorderQuantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private DashboardDto? _data;
    private bool _loading = true;
    private string? _error;
    private bool _chartsRendered;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _error = null;
        _chartsRendered = false;
        var (data, err) = await DashboardApi.GetDashboardAsync();
        _data = data;
        _error = err;
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data != null && !_chartsRendered && !_loading)
        {
            _chartsRendered = true;
            await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        if (_data == null) return;

        var kpiLabels = new[] { "低库存", "临期批次", "在售药品", "待审PO" };
        var kpiValues = new[] { _data.LowStockCount, _data.ExpiryAlertCount, _data.ActiveDrugCount, _data.PendingPurchaseOrders };
        await JS.InvokeVoidAsync("renderKpiChart", kpiLabels, kpiValues);

        if (_data.TopMovingDrugs.Any())
        {
            var labels = _data.TopMovingDrugs.Select(d => d.DrugName).ToArray();
            var values = _data.TopMovingDrugs.Select(d => d.TotalOutQuantity).ToArray();
            await JS.InvokeVoidAsync("renderTopMovingChart", labels, values);
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
