<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>未找到页面</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <p>请求的页面不存在。</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    [Inject] private AuthStateService AuthState { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized()
    {
        AuthState.Unauthorized += OnUnauthorized;
    }

    private Task OnUnauthorized()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
        return Task.CompletedTask;
    }
}
